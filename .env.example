# Backend Configuration (Render or Local)
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=careerpilot.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://career-pilot-ai-henna.vercel.app
ALLOWED_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?|https://.*\.vercel\.app

# Frontend Configuration (Vercel)
# In production on Vercel, set VITE_API_URL to your deployed Render backend:
VITE_API_URL=https://careerpilot-ai-backend-3b8o.onrender.com

# Optional LLM Configuration (Application runs 100% deterministically without API keys)
# Set GEMINI_API_KEY to your Google AI Studio key if you want live Gemini synthesis
GEMINI_API_KEY=
# Or set OPENAI_API_KEY
OPENAI_API_KEY=
LLM_PROVIDER=deterministic
LLM_MODEL=gemini-1.5-flash
