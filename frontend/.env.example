# Frontend Environment Variables
# In production on Vercel, set VITE_API_URL to your deployed Render backend:
# Example: https://careerpilot-ai-backend-3b8o.onrender.com
# Trailing slashes and '/api' paths are automatically normalized.
VITE_API_URL=https://careerpilot-ai-backend-3b8o.onrender.com

# Optional legacy alias
VITE_API_BASE_URL=
